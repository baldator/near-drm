# NEAR Testnet keys — NEVER commit real keys to the repo
NEAR_TESTNET_PRIVATE_KEY=ed25519:your_private_key_here
NEAR_TESTNET_ACCOUNT_ID=your_account.testnet
REACT_APP_CONTRACT_ID=vault.testnet

# NEAR MPC Confidential Key Derivation (CKD)
# Testnet signer contract and a ConfidentialKeyDerivation domain (2 or 6).
REACT_APP_MPC_CONTRACT_ID=v1.signer-prod.testnet
REACT_APP_CKD_DOMAIN_ID=2
REACT_APP_CKD_DERIVATION_PATH=near-drm/encryption/v1
# Optional: pin the domain's BLS12-381 G2 public key. When unset the app reads
# it from the signer contract's `state()` view call.
# REACT_APP_MPC_BLS_PUBLIC_KEY=bls12381g2:...

# Pinata IPFS — https://app.pinata.cloud/developers/api-keys
REACT_APP_PINATA_JWT=your_pinata_jwt_here
# Optional: dedicated gateway (defaults to https://gateway.pinata.cloud)
# REACT_APP_PINATA_GATEWAY=https://your-gateway.mypinata.cloud
# Optional: server-side upload proxy (keeps the JWT off the client)
# REACT_APP_PINATA_UPLOAD_URL=https://your-api.example.com/pinata/upload